[Unit]
Description=WeChat Read-only Gateway V0.1
After=network.target

[Service]
Type=simple
WorkingDirectory=%h/pohub/gateway
ExecStart=/usr/bin/node src/collector.js
Restart=on-failure
RestartSec=10
Environment=NODE_NO_WARNINGS=1
EnvironmentFile=-%h/.config/personal-operations-hub/gateway.env

[Install]
WantedBy=default.target
